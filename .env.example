# Copy this file to .env for local development.
# These must be HTTPS checkout/payment links issued by your approved merchant provider.
# Do NOT put personal card numbers, passwords, CVV codes, or bank login details here.
PAYMENT_LINK_STARTER=
PAYMENT_LINK_PRO=
PAYMENT_LINK_ELITE=

# Render provides PORT automatically; set NODE_ENV=production in production.
NODE_ENV=development